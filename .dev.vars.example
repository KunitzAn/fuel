# Копия в .dev.vars — читается `wrangler pages dev` для локального API.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/fuel?sslmode=require"
CATALOG_DATABASE_URL="postgresql://user:pass@ep-yyy-pooler.region.aws.neon.tech/fuel-catalog?sslmode=require"
SESSION_SECRET="openssl rand -hex 32"
RESEND_API_KEY="re_..."
# Отправитель — только подтверждённый в Resend домен/поддомен
# (resend.com/domains), не обязательно корневой kunitcan.online
LOGIN_EMAIL_FROM="Fuel <fuel@hithere.kunitcan.online>"
APP_URL="http://localhost:8788"
